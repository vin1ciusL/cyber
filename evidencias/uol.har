ay:flex;justify-content:center;align-items:center;margin-top:16px;z-index:2;width:100%}.flashFeed__indicators-container{width:80px;overflow:hidden;position:relative}.flashFeed__indicators-container--centered{width:auto;overflow:visible}.flashFeed__indicators-wrapper{display:flex;gap:4px;margin:0;padding:0;list-style:none;transition:transform .4s ease;position:relative;left:0}.flashFeed__indicator{display:block;flex-shrink:0;width:8px;height:8px;background-color:#c2c2c2;border:none;border-radius:50%;opacity:.6;transition:opacity .5s linear,background-color .5s linear}.flashFeed__indicator--active{background-color:#000;opacity:1}.flashFeed .flashFeedCard{height:100%}.flashFeed .flashFeedCard__media{width:100%;height:100%;overflow:hidden}.flashFeed .flashFeedImage{width:100%;height:100%}.flashFeed .flashFeedImage .photograph{display:block;width:100%;height:100%}.flashFeed .flashFeedImage .photograph__container{display:block;height:100%;padding-top:0 !important;border-radius:0;background:none}.flashFeed .flashFeedImage .photograph__image{object-fit:contain;border-radius:0;-webkit-transform:translateZ(0);transform:translateZ(0);-webkit-backface-visibility:hidden;backface-visibility:hidden}</style><script src=\"//h.jsuol.com.br/assets/?loadComponent=Media&contentType=js&scope=assets&asset=/app~21833f8f.ab5c3d03ca1d876328c4.js\" async crossorigin=\"anonymous\"></script>\n<script src=\"//h.jsuol.com.br/assets/?loadComponent=Media&contentType=js&scope=assets&asset=/app~24120820.619addfe0c62715e443c.js\" async crossorigin=\"anonymous\"></script>\n<script src=\"//h.jsuol.com.br/assets/?loadComponent=Media&contentType=js&scope=assets&asset=/app~31ecd969.01e22c13cab19c46de5b.js\" async crossorigin=\"anonymous\"></script>\n<script src=\"//h.jsuol.com.br/assets/?loadComponent=Media&contentType=js&scope=assets&asset=/app~46149c87.759a30a171c3ab6ef2bb.js\" async crossorigin=\"anonymous\"></script>\n<script src=\"//h.jsuol.com.br/assets/?loadComponent=Media&contentType=js&scope=asset