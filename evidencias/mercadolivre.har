-grid-container-image\" data-andes-card-content=\"true\"><img src=\"https://http2.mlstatic.com/storage/homes-korriban/assets/icons/xxhdpi/home_microsoft-category.webp\" alt=\"Mais Categorias\" loading=\"eager\" aria-hidden=\"true\" data-id=\"_R_7nemfgla_\" decoding=\"async\" is=\"n-img\"/></div><div class=\"andes-card__footer card-grid-footer andes-card__footer--border\" data-andes-card-footer=\"true\"><p class=\"card-grid-item__title\"><a class=\"card-grid-anchor\" href=\"https://www.mercadolivre.com.br/c/mais-categorias#c_id=/home/categories/element&amp;c_category_id=MLB1953&amp;c_uid=15a5ab99-2b41-4fd3-9578-c33e4c4563f5\" tabindex=\"-1\">Mais Categorias</a></p></div></div></div></div></div></div><button class=\"andes-carousel-snapped__control andes-carousel-snapped__control--next andes-carousel-snapped__control--size-large\" data-andes-carousel-snapped-control=\"next\" data-andes-state=\"\" type=\"button\" aria-label=\"Seguinte\" name=\"andes-carousel-snapped_control\"><svg aria-hidden=\"true\" color=\"var(--andes-color-icon-primary, rgba(0, 0, 0, 0.9))\" width=\"32\" height=\"32\" viewBox=\"0 0 32 32\" fill=\"currentColor\"><path d=\"M11.943 6.99999L20.9383 15.9953L11.9336 25L12.9943 26.0607L23.0596 15.9953L13.0036 5.93933L11.943 6.99999Z\" fill=\"currentColor\"></path></svg></button></div></section></div></div></section></div></div><div style=\"display:contents\"><div><section class=\"site-shopping-info\" type=\"site-shopping-info\"><div class=\"container\"><div class=\"info-slide\"><div class=\"img-container\"><img src=\"https://http2.mlstatic.com/storage/homes-korriban/assets/images/ecosystem/payment.svg\" class=\"img-container\" alt=\"\" loading=\"eager\" data-id=\"_R_5ggla_\" decoding=\"async\" is=\"n-img\"/></div><h2>Escolha como pagar</h2><p>Com Mercado Pago, você paga com cartão, boleto ou Pix. Você também pode pagar em até 12x sem cartão com a Linha de Crédito.<!-- --> </p><a href=\"https://www.mercadolivre.com.br/pagar-online-com-mercadopago/\">Como pagar com Mercado Pago</a></div><div class=\"info-slide\"><div class=\"img-container\"><img src=\"https://http2.mlstatic.com/storage/homes-korriban/assets/images/ecosystem/shipping.svg\" class=\"img-container\" alt=\"\" loading=\"eager\" data-id=\"_R_6ggla_\" decoding=\"async\" is=\"n-img\"/></div><h2>Frete grátis por ser sua primeira compra</h2><p>Aproveite este benefício em milhões de produtos.<!-- --> </p></div><div class=\"info-slide\"><div class=\"img-container\"><img src=\"https://http2.mlstatic.com/storage/homes-korriban/assets/images/ecosystem/protected.svg\" class=\"img-container\" alt=\"\" loading=\"eager\" data-id=\"_R_7ggla_\" decoding=\"async\" is=\"n-img\"/></div><h2>Segurança, do início ao fim</h2><p>Você não gostou do que comprou? Devolva! No Mercado Livre não há nada que você não possa fazer, porque você está sempre protegido.<!-- --> </p><a href=\"https://www.mercadolivre.com.br/compra-garantida\">Como te protegemos</a></div></div></section></div></div></div><script nonce=\"DBWVr7XQg+QoDgT4ujOo8w==\">\n        (function(h,o,t,j,a,r){\n          h.hj= h.hj || function(){(h.hj.q=h.hj.q||[]).push(arguments)};\n          h._hjSettings={hjid:720738,hjsv:5};\n          a=o.getElementsByTagName('head')[0];\n          r=o.createElement('script');r.async=1;\n          r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv;\n          a.appendChild(r);\n        })(window,document,'//static.hotjar.com/c/hotjar-','.js?sv=');\n        \n      </script><div id=\"_R_qla_\" style=\"display:contents\"><svg xmlns=\"http://www.w3.org/2000/svg\" style=\"display:none\"><defs><symbol id=\"poly_full\" viewBox=\"0 0 41 13\"><path d=\"M2.628 0h5.255L5.255 4.643h4.38L2.628 13l1.751-5.571H0L2.628 0zm11.589 9.533h-1.959l1.674-7.515H19.5l-.376 1.69h-3.61l-.25 1.172h3.519l-.376 1.69h-3.53l-.66 2.963zm9.468.136c-2.334 0-3.484-1.105-3.484-2.682 0-.124.034-.383.057-.496l1.002-4.473h1.992l-.99 4.428c-.012.057-.034.18-.034.316.011.62.49 1.217 1.457 1.217 1.048 0 1.583-.654 1.776-1.533l.991-4